---
// SPDX-FileCopyrightText: 2026 Cisco Systems, Inc.
// SPDX-License-Identifier: Apache-2.0
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 8)}`;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#00BCEB" />
      <stop offset="1" stop-color="#0A60D8" />
    </linearGradient>
  </defs>
  <rect x="1" y="1" width="30" height="30" rx="9" fill={`url(#${id})`} />
  <circle cx="16" cy="16" r="8.5" fill="none" stroke="#fff" stroke-width="2" opacity="0.95" />
  <path d="M16 4.5v4M16 23.5v4M4.5 16h4M23.5 16h4" stroke="#fff" stroke-width="2" stroke-linecap="round" />
  <path d="m16 16 4.2-4.2" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
  <circle cx="16" cy="16" r="1.8" fill="#fff" />
</svg>
