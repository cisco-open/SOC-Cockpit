---
// SPDX-FileCopyrightText: 2026 Cisco Systems, Inc.
// SPDX-License-Identifier: Apache-2.0
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuickStart from '../components/QuickStart.astro';
import { REPO, url } from '../lib/site';

const env = [
  { name: 'PORT', def: '3001', purpose: 'API / production server port.' },
  { name: 'NODE_ENV', def: 'development', purpose: 'Set to production to serve the built frontend.' },
  { name: 'SESSION_TTL_HOURS', def: '12', purpose: 'How long a sign-in session lasts.' },
  { name: 'SESSION_COOKIE_SECURE', def: 'true in production', purpose: 'Send the session cookie over HTTPS only.' },
  { name: 'LDAP_URL', def: '(unset)', purpose: 'ldaps:// URL of Active Directory. Empty = local accounts only.' },
  { name: 'LDAP_BASE_DN', def: '(unset)', purpose: 'Search base for user lookups. Required with LDAP.' },
  { name: 'LDAP_BIND_DN / LDAP_BIND_PASSWORD', def: '(unset)', purpose: 'Read-only service account for user lookups. Required with LDAP.' },
  { name: 'LDAP_USER_FILTER', def: 'sAMAccountName={username}', purpose: 'LDAP filter used to find the user.' },
  { name: 'LDAP_STARTTLS / LDAP_CA_CERT_PATH / LDAP_ALLOW_INSECURE', def: 'false / (unset) / false', purpose: 'TLS options for LDAP.' },
  { name: 'OPENAI_API_KEY', def: '(unset)', purpose: 'Enables AI features. If empty, a local fallback is used.' },
  { name: 'OPENAI_BASE_URL', def: 'https://api.openai.com/v1', purpose: 'Base URL of any OpenAI-compatible API.' },
  { name: 'OPENAI_MODEL', def: 'gpt-4o-mini', purpose: 'Model or deployment name.' },
];

const commands = [
  { cmd: 'npm run dev', text: 'Start the web app and API together for development.' },
  { cmd: 'npm run build', text: 'Type-check and build the frontend.' },
  { cmd: 'npm start', text: 'Serve the production build from the API server.' },
];
---

<Base title="Get started" description="Install, configure and run SOC Cockpit locally or in production.">
  <section class="wrap page-hero">
    <span class="eyebrow">Get started</span>
    <h1>From clone to <span class="grad-text">command console.</span></h1>
    <p class="lede">SOC Cockpit is a two-tier Node.js app with an embedded SQLite store. There are no external services to provision.</p>
  </section>

  <div class="wrap gs">
    <ol class="steps">
      <li class="reveal">
        <span class="marker"><Icon name="cpu" size={18} /></span>
        <div>
          <h2>Prerequisites</h2>
          <p><strong>Node.js 22.5 or later</strong> (the server uses the built-in <code>node:sqlite</code> module) and npm.</p>
          <p class="note">On Windows PowerShell, use <code>npm.cmd</code> if script execution policy blocks <code>npm</code>.</p>
        </div>
      </li>

      <li class="reveal">
        <span class="marker"><Icon name="terminal" size={18} /></span>
        <div>
          <h2>Install and run</h2>
          <QuickStart />
          <div class="ports">
            <span class="chip"><span class="dot"></span> Web UI · <code>http://127.0.0.1:5173/</code></span>
            <span class="chip"><span class="dot"></span> API · <code>http://127.0.0.1:3001/</code></span>
          </div>
        </div>
      </li>

      <li class="reveal">
        <span class="marker"><Icon name="lock" size={18} /></span>
        <div>
          <h2>Create the first Admin</h2>
          <p>
            Sign-in is required. On first start with no users, the server prints a <strong>one-time setup code</strong> to its
            console. Open the app, enter the code and create the first Admin — public setup is then disabled for good.
          </p>
          <div class="roles">
            <div><strong>Viewer</strong><span>Read-only, may use the assistant</span></div>
            <div><strong>Operator</strong><span>Read and edit cockpit data</span></div>
            <div><strong>Admin</strong><span>Everything, plus user management</span></div>
          </div>
          <p class="note">
            Users are <strong>local</strong> (password hashed with scrypt) or <strong>company</strong> (checked against Active
            Directory). Company users are registered on first sign-in and stay blocked until an Admin approves them in <strong>Users</strong>.
            Directory settings can also be managed in the app under <strong>Users &gt; Company directory</strong>.
          </p>
        </div>
      </li>

      <li class="reveal">
        <span class="marker"><Icon name="layers" size={18} /></span>
        <div>
          <h2>Configure</h2>
          <p>Configuration is read from <code>.env</code>. Every variable is optional.</p>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>Variable</th><th>Default</th><th>Purpose</th></tr>
              </thead>
              <tbody>
                {
                  env.map((v) => (
                    <tr>
                      <td><code>{v.name}</code></td>
                      <td><code class="soft">{v.def}</code></td>
                      <td>{v.purpose}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="note">
            The LLM integration targets the standard <code>POST {'{OPENAI_BASE_URL}'}/chat/completions</code> API, so it works with
            OpenAI, OpenAI-compatible gateways and self-hosted servers such as Ollama or vLLM.
          </p>
        </div>
      </li>

      <li class="reveal">
        <span class="marker"><Icon name="server" size={18} /></span>
        <div>
          <h2>Build for production</h2>
          <div class="cmds">
            {
              commands.map((c) => (
                <div class="cmd">
                  <code>{c.cmd}</code>
                  <span>{c.text}</span>
                </div>
              ))
            }
          </div>
          <p class="note">
            Production mode serves the built frontend from the Express server. <code>data/</code>, <code>uploads/</code> and
            <code>artifacts/</code> hold local runtime data and are git-ignored — back them up on your normal schedule.
          </p>
        </div>
      </li>

      <li class="reveal">
        <span class="marker"><Icon name="shield" size={18} /></span>
        <div>
          <h2>Deploy it safely</h2>
          <p>
            Run Cockpit inside a restricted network reachable only by approved SOC staff. Terminate TLS at a reverse proxy,
            keep <code>SESSION_COOKIE_SECURE</code> enabled, bind the app to loopback or a private interface, and connect
            Active Directory over <code>ldaps://</code> or StartTLS.
          </p>
          <div class="links">
            <a class="btn btn-primary" href={url('faq/')}>Security &amp; deployment FAQ <Icon name="arrow" size={16} /></a>
            <a class="btn btn-ghost" href={`${REPO}/blob/main/DEVELOPMENT.md`} rel="noopener"><Icon name="book" size={16} /> Development guide</a>
          </div>
        </div>
      </li>
    </ol>
  </div>
</Base>

<style>
  .gs {
    max-width: 920px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* Glowing rail connecting the step markers. */
  .steps::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(180deg, var(--sky), var(--royal) 70%, transparent);
    opacity: 0.45;
  }

  .steps > li {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 1.5rem;
    padding-bottom: 3.5rem;
  }

  .marker {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    color: #fff;
    background: var(--grad);
    box-shadow: 0 10px 24px -10px rgba(4, 159, 217, 0.9), 0 0 0 6px var(--bg);
  }

  .steps h2 {
    font-size: 1.55rem;
    margin-top: 0.45rem;
  }

  .steps p {
    color: var(--ink-2);
  }

  .steps :not(pre) > code {
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--midnight);
  }

  .note {
    font-size: 0.92rem;
    color: var(--muted) !important;
  }

  .ports {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .ports code {
    background: none !important;
    border: 0 !important;
    padding: 0 !important;
  }

  .roles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .roles div {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--sky);
  }

  .roles span {
    font-size: 0.86rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .roles {
      grid-template-columns: 1fr;
    }
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow);
    margin-bottom: 1rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  th,
  td {
    padding: 0.8rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  th {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--surface-2);
  }

  td {
    color: var(--ink-2);
  }

  td:first-child code {
    overflow-wrap: anywhere;
  }

  code.soft {
    color: var(--muted) !important;
  }

  .cmds {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .cmd {
    display: grid;
    grid-template-columns: 170px 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .cmd code {
    background: none !important;
    border: 0 !important;
    padding: 0 !important;
    color: var(--royal) !important;
    font-weight: 600;
  }

  .cmd span {
    color: var(--ink-2);
    font-size: 0.93rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 560px) {
    .steps > li {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .steps::before {
      display: none;
    }

    .cmd {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
