# SOC Cockpit environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Server ----
# Port the Express API / production server listens on.
PORT=3001
# Set to "production" to serve the built frontend from the API server.
NODE_ENV=development

# ---- Sign-in / sessions ----
# On first start with no users, a one-time setup code is printed to the server
# console; enter it on the setup page to create the first Admin account.
# How long a sign-in lasts, in hours.
SESSION_TTL_HOURS=12
# Mark the session cookie Secure (HTTPS only). Defaults to true when
# NODE_ENV=production. Only set to false for plain-HTTP lab setups.
SESSION_COOKIE_SECURE=

# ---- Active Directory / LDAP (optional) ----
# Usually configured by an Admin in the app: Users > Company directory.
# Anything set here overrides the in-app value and shows as locked there.
# LDAP_URL=ldaps://dc01.corp.local
# LDAP_STARTTLS=false
# LDAP_CA_CERT_PATH=
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=
# LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(sAMAccountName={username}))
# Lab only: allow unencrypted ldap:// (sends passwords in clear text).
# LDAP_ALLOW_INSECURE=false
# Key used to encrypt the service account password saved from the app.
# If unset, a random key is created in data/.auth-secret.key.
# SETTINGS_ENCRYPTION_KEY=

# ---- LLM provider (OpenAI-compatible Chat Completions API) ----
# Required to enable Advisor brief generation and the Cockpit assistant.
# Works with OpenAI, Azure OpenAI-compatible gateways, Ollama, vLLM, etc.
# If OPENAI_API_KEY is empty, the app falls back to a locally generated brief.
OPENAI_API_KEY=
# Base URL of the API (no trailing /chat/completions). Defaults to OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1
# Model / deployment name to call.
OPENAI_MODEL=gpt-4o-mini
