{
  "name": "soc-cockpit",
  "version": "0.1.0",
  "description": "Web-based SOC governance cockpit for service and operations management.",
  "license": "Apache-2.0",
  "main": "server/app.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/app.cjs",
    "export:handover": "node scripts/export-handover.cjs",
    "build": "tsc -b && vite build",
    "start": "cross-env NODE_ENV=production node server/app.cjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "lucide-react": "1.23.0",
    "multer": "2.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "wait-on": "9.0.10"
  }
}
